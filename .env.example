# ============================================================
# AIRFLOW
# ============================================================
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=sua-senha-aqui
AIRFLOW_ADMIN_FIRSTNAME=Nome
AIRFLOW_ADMIN_LASTNAME=Sobrenome
AIRFLOW_ADMIN_EMAIL=seu-email@empresa.com

# ============================================================
# POSTGRES (banco interno do Airflow)
# ============================================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=sua-senha-aqui
POSTGRES_DB=airflow

# ============================================================
# GCP
# ============================================================
GCP_PROJECT_DEV=seu-projeto-dev
GCP_PROJECT_PROD=seu-projeto-prod
GCP_CREDENTIALS=/opt/airflow/secrets/sua-chave-service-account.json
GCP_BUCKET_RAW=seu-bucket-raw

# ============================================================
# DBT
# ============================================================
DBT_TARGET=dev

# ============================================================
# ALERTA DE FALHA POR E-MAIL (Gmail)
# SMTP_PASSWORD é uma "senha de app" do Google (16 letras),
# não a senha normal da conta. ALERT_EMAIL vazio = sem e-mail.
# ============================================================
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
ALERT_EMAIL=quem-recebe@email.com